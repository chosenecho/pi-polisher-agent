# ==============================================================================
# 方式一：使用 Pi 内置 Provider（任选其一配置对应 API Key 即可）
# ==============================================================================
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GEMINI_API_KEY=...
# DEEPSEEK_API_KEY=sk-...
# OPENROUTER_API_KEY=sk-or-...

# 可选：手动指定 Provider、模型 ID 与思考强度（off | minimal | low | medium | high | xhigh | max）
# PI_PROVIDER=deepseek
# PI_MODEL=deepseek-chat
# PI_THINKING_LEVEL=high

# ==============================================================================
# 方式二：使用自定义 OpenAI 兼容接口（如本地路由、阿里云百炼 DashScope、OneAPI、Ollama、vLLM 等）
# ==============================================================================
# CUSTOM_BASE_URL=http://127.0.0.1:3425/v1
# CUSTOM_API_KEY=sk-placeholder
# CUSTOM_MODEL=auto/deepseek-v4.1-flash
# CUSTOM_MAX_TOKENS=65536
# CUSTOM_CONTEXT_WINDOW=1048576
# CUSTOM_REASONING=true
# PI_THINKING_LEVEL=high

# ==============================================================================
# 可选：为评审 Agent 单独指定模型或思考强度（默认复用润色 Agent 配置）
# ==============================================================================
# REVIEW_PROVIDER=
# REVIEW_MODEL=
# REVIEW_THINKING_LEVEL=high
